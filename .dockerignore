# Build context is an allowlist; local secrets/private repositories never enter it.
**
!Dockerfile.local
!.dockerignore
!package.json
!package-lock.json
!LICENSE
!tsconfig*.json
!apps/
!apps/**
!packages/
!packages/**
!database/
!database/**
!contracts/
!contracts/**
!vendor/
!vendor/**
!scripts/
!scripts/write-notices.mjs
!scripts/serve-offline.mjs
!scripts/local-runtime.mjs
**/node_modules/**
**/dist/**
**/.env
**/.env.*
**/.npmrc
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.log
**/.local/**
**/.aws/**
**/test-results/**
**/playwright-report/**
