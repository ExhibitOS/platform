{
  "openapi": "3.1.0",
  "info": {
    "title": "ExhibitOS immutable freeze and bounded offline API",
    "version": "0.1.0",
    "description": "Ed25519 signatures bind canonical manifest and short-lived grant. Maximum disconnected grant is8h capped by requesting session and every current/historical governing rights expiry. Disconnected clients cannot learn new revocation before deadline; delivered copies are not DRM. Historical scenes and runtime bytes survive draft edits and builds. No stored bytes automatically deleted after completion. Durable precommitted receipt inventories preserve rollback/crash cleanup ownership; recover expired failed attempts only."
  },
  "paths": {
    "/api/v1/tenants/{tenantId}/studio/exhibitions/{id}/freezes": {
      "post": {
        "summary": "Create an immutable freeze of the exact saved If-Match revision; retain OEX and all actual runtime bytes",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized success, no-store"
          },
          "403": {
            "description": "Tenant/source owner/current display AND export grant/session/origin/CSRF/availability/key denied"
          },
          "409": {
            "description": "Integrity/source approval/idempotency/job lease conflict"
          },
          "503": {
            "description": "Missing or invalid signed runtime/key/format config"
          },
          "201": {
            "description": "Created or exact completed receipt replay; manifest/signature/runtime hashes pinned, never publication"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requestId"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List latest50 freezes of the owned/admin Studio source",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
