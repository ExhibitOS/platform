                }
              }
            }
          },
          "403": {
            "description": "Structured denied/input/state/integrity/storage error; no private object keys or decoder details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Structured denied/input/state/integrity/storage error; no private object keys or decoder details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Structured denied/input/state/integrity/storage error; no private object keys or decoder details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Structured denied/input/state/integrity/storage error; no private object keys or decoder details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Structured denied/input/state/integrity/storage error; no private object keys or decoder details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Structured denied/input/state/integrity/storage error; no private object keys or decoder details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Structured denied/input/state/integrity/storage error; no private object keys or decoder details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "artworkId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "mime": {
                    "enum": [
                      "model/gltf-binary",
                      "image/png"
                    ]
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 33554432
                  },
                  "scaleMeters": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000
                  },
                  "rights": {
                    "type": "object",
                    "description": "Full public OES artwork rights schema; legacy flat grants fail closed."
                  }
                },
                "required": [
                  "artworkId",
                  "idempotencyKey",
                  "mime",
                  "sha256",
                  "bytes",
                  "scaleMeters",
                  "rights"
                ]
              }
            }
          }
        }
      }
    },
