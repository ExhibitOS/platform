{
  "openapi": "3.1.1",
  "info": {
    "title": "ExhibitOS primary asset imports",
    "version": "0.1.0",
    "description": "Authenticated existing-artwork GLB/PNG import candidate. Quarantine is never public; approved profile is separate from publication rights. No URL fetch, OEX archive, JPEG/WebP or complete OES directory import."
  },
  "paths": {
    "/api/v1/tenants/{tenantId}/imports": {
      "post": {
        "summary": "Create or replay a tenant-owned import",
        "operationId": "importCreate",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured origin; Host must also match exactly."
          }
        ],
        "security": [
          {
            "LocalSession": [],
            "Csrf": []
          },
          {
            "NetworkSession": [],
            "Csrf": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success after transaction completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Structured denied/input/state/integrity/storage error; no private object keys or decoder details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Structured denied/input/state/integrity/storage error; no private object keys or decoder details",
            "content": {
