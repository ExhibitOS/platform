  "components": {
    "securitySchemes": {
      "InstitutionBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque scoped token"
      },
      "LocalSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "exhibitos_local_session"
      },
      "NetworkSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-exhibitos_session"
      }
    },
    "schemas": {
      "InventoryMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accessionNumber",
          "classification",
          "preservationStatus",
          "history"
        ],
        "properties": {
          "accessionNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "classification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "preservationStatus": {
            "type": "string",
            "enum": [
              "unknown",
              "complete",
              "incomplete"
            ]
          },
          "acquisitionYear": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "history": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "year",
                "description"
              ],
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9999
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            }
          },
          "exhibitionHistory": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "year",
                "description"
              ],
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9999
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            }
          },
          "conservationHistory": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "year",
                "description"
              ],
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9999
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            }
          },
          "bibliography": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        }
      }
    }
