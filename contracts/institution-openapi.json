              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Closed shape or malformed input"
          },
          "401": {
            "description": "Current credential unavailable"
          },
          "403": {
            "description": "Current membership, scope, tenant, artwork or rights refused"
          },
          "429": {
            "description": "Scoped request quota exhausted"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
