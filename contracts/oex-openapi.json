{
  "openapi": "3.1.0",
  "info": {
    "title": "ExhibitOS OEX preservation API",
    "version": "0.1.0",
    "description": "Authentication/tenant role and current grant validation are server-side. No publication, source overwrite, arbitrary URL fetch or executable scripts. Quiesced DB/blob backups must include migration009 and OEX staged receipts. Workers revalidate current actor membership under policy and maintenance locks. Failed import leaves prior rows unchanged, owned disposable cleanup is durable, successful destination bytes retained."
  },
  "paths": {
    "/api/v1/tenants/{tenantId}/studio/exhibitions/{id}/oex/export": {
      "post": {
        "summary": "Export the exact If-Match Studio immutable revision with current explicit export grants and source ownership",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded complete OEX ZIP, no-store attachment. Private CMS bindings stripped; unknown namespaces denied. Received copies cannot be remotely revoked.",
            "content": {
              "application/vnd.exhibitos.oex+zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "description": "Tenant/owner/rights/CSRF/Origin denied"
          },
          "409": {
            "description": "Job state, source approval or idempotency conflict"
          },
          "422": {
            "description": "Package/profile/decoder/hash rejected"
          },
          "413": {
            "description": "Body bound exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/v1/tenants/{tenantId}/oex/imports": {
      "get": {
        "summary": "List latest50 owned jobs (admin tenantwide), summaries omit full draft results",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Tenant/owner/rights/CSRF/Origin denied"
          },
          "409": {
            "description": "Job state, source approval or idempotency conflict"
          },
          "422": {
            "description": "Package/profile/decoder/hash rejected"
          },
          "413": {
            "description": "Body bound exceeded"
          }
        }
      },
      "post": {
        "summary": "Create a durable artist/admin import receipt (max16 retained staging jobs and512MiB tenant staging quota)",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Tenant/owner/rights/CSRF/Origin denied"
          },
          "409": {
            "description": "Job state, source approval or idempotency conflict"
          },
          "422": {
            "description": "Package/profile/decoder/hash rejected"
          },
          "413": {
            "description": "Body bound exceeded"
          },
          "201": {
            "description": "Created or exact idempotent receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requestId",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 67108864
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    },
