  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "exhibitos_session"
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "required": [
          "id",
          "state",
          "attempts",
          "errorCode",
          "result",
          "cleanupPending"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "uploading",
              "queued",
              "processing",
              "failed",
              "cancelled",
              "complete"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": [
              "object",
              "null"
            ],
            "description": "Only completed jobs include a new private Studio draft, revision/etag, exhibitionId and typed old-to-new idMap plus assetAliases. Shared source assets materialize per-artwork IDs/paths while reusing identical private bytes. idMap is not bijective for shared assets; assetAliases provides source artwork revision, source asset/path and destination artwork revision/asset/path. Never publication. Re-export remains bounded64MiB including distinct aliased package entries."
          },
          "cleanupPending": {
            "type": "boolean"
          }
        }
      }
    }
  }
}