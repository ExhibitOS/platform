0e12bf0c","target":[-2.2,1.5,-4.94],"position":[-2.2,1.65,-2]}}},"navigation":[],"placements":[{"id":"223e987b-9350-4063-98d5-ff95212c83e3","roomId":"37df830d-5bb4-4a2f-9aa3-15720e12bf0c","assetId":"92836c42-3c17-43d8-9420-25b500f8c6e5","transform":{"scale":[1,1,1],"position":[-2.2,1.5,-4.94],"rotation":[0,0,0,1]},"artworkRevisionId":"2581d9a4-0526-49e1-9e3c-e263ad4f637a"},{"id":"ae8bed75-6e8c-4870-998b-30ad251b7a35","roomId":"37df830d-5bb4-4a2f-9aa3-15720e12bf0c","assetId":"49501cc2-3592-41af-bf9c-6a4b26ee069b","transform":{"scale":[1,1,1],"position":[0,1.5,-4.94],"rotation":[0,0,0,1]},"artworkRevisionId":"ebf8a090-9e7f-4b23-ad6e-9454709b4712"},{"id":"a63cc9ec-d3bf-406f-80dc-5c8ffe952335","roomId":"37df830d-5bb4-4a2f-9aa3-15720e12bf0c","assetId":"3e66b14c-d82c-465a-bf2e-dee8eb78342d","transform":{"scale":[1,1,1],"position":[2.2,1.5,-4.94],"rotation":[0,0,0,1]},"artworkRevisionId":"a5ffc52a-e13a-4205-a584-72009cf8efcb"}],"revisionId":"8e3e39a7-966f-4808-9d12-3cb97e4e3372","annotations":[],"coordinates":"right-handed-y-up","mediaAssets":[],"accessibility":{"routeIds":[],"reducedMotion":true,"alternativeView":"list","keyboardNavigation":true,"artworkDescriptions":[{"text":"빈센트 반 고흐 · Wheat Field with Cypresses · 1889 · 캔버스에 유채 · 73.2 × 93.4 cm · 메트로폴리탄 미술관, 1993.132\n\n밀밭과 하늘을 이루는 붓질의 방향을 따라가 보세요. 아래쪽의 짧고 비스듬한 선과 위쪽의 크게 굽이치는 선이 화면의 서로 다른 움직임을 만듭니다.\n\n가로 화면 아래에는 노란 밀밭이 펼쳐지고, 가운데에는 녹색 관목과 푸른 산이 보입니다. 오른쪽의 짙은 녹색 나무가 높게 솟아 있습니다. 위쪽 하늘에는 흰 구름과 푸른색·청록색의 굽은 붓자국이 이어집니다.","placementId":"223e987b-9350-4063-98d5-ff95212c83e3"},{"text":"렘브란트 판 레인 · Aristotle with a Bust of Homer · 1653 · 캔버스에 유채 · 143.5 × 136.5 cm · 메트로폴리탄 미술관, 61.198\n\n밝게 드러난 손과 소매, 흉상을 차례로 살펴보세요. 한 화면에서 그려진 석상과 옷감, 금속 사슬이 서로 다른 표면으로 보이는 방식을 비교할 수 있습니다.\n\n어두운 배경 앞에 검은 모자와 밝고 넓은 소매의 옷을 입은 남자가 서 있습니다. 화면 왼쪽의 밝은 흉상 머리 위에 한 손을 얹고, 다른 손은 허리 가까이에 둡니다. 금빛 사슬이 가슴과 허리를 가로지릅니다.","placementId":"ae8bed75-6e8c-4870-998b-30ad251b7a35"},{"text":"폴 세잔 · Still Life with Apples and Pears · 약 1891–1892 · 캔버스에 유채 · 44.8 × 58.7 cm · 메트로폴리탄 미술관, 61.101.3\n\n과일의 윤곽과 과일 사이의 빈 공간을 번갈아 보세요. 노란색·빨간색·녹색 면과 짙은 테두리가 둥근 과일을 드러내며, 뒤쪽의 접시와 벽은 깊이를 다르게 느끼게 합니다.\n\n나무 탁자 위에 노란색과 녹색의 배, 붉은색과 노란색의 사과가 놓여 있습니다. 뒤쪽에는 푸른 테두리의 흰 접시 두 개가 일부 보이고, 벽은 푸른 회색입니다. 탁자 앞면과 오른쪽 다리도 화면에 들어와 있습니다.","placementId":"a63cc9ec-d3bf-406f-80dc-5c8ffe952335"}],"stationaryNavigation":true},"schemaVersion":"1.0.0-draft.1"},"assets":[{"assetId":"92836c42-3c17-43d8-9420-25b500f8c6e5","url":"/api/v1/publications/a63bd450-8c1a-48df-83eb-69e3f0e64ee1/assets/92836c42-3c17-43d8-9420-25b500f8c6e5","mime":"image/png"},{"assetId":"8e1ed8e6-781f-41fa-a519-af88b13da781","url":"/api/v1/publications/a63bd450-8c1a-48df-83eb-69e3f0e64ee1/assets/8e1ed8e6-781f-41fa-a519-af88b13da781","mime":"image/png"},{"assetId":"49501cc2-3592-41af-bf9c-6a4b26ee069b","url":"/api/v1/publications/a63bd450-8c1a-48df-83eb-69e3f0e64ee1/assets/49501cc2-3592-41af-bf9c-6a4b26ee069b","mime":"image/png"},{"assetId":"773d81a8-db6e-4da6-9f06-37a71fd22bd9","url":"/api/v1/publications/a63bd450-8c1a-48df-83eb-69e3f0e64ee1/assets/773d81a8-db6e-4da6-9f06-37a71fd22bd9","mime":"image/png"},{"assetId":"3e66b14c-d82c-465a-bf2e-dee8eb78342d","url":"/api/v1/publications/a63bd450-8c1a-48df-83eb-69e3f0e64ee1/assets/3e66b14c-d82c-465a-bf2e-dee8eb78342d","mime":"image/png"},{"assetId":"eb4a2aec-5b6e-4291-a0c2-afb37b07d3c8","url":"/api/v1/publications/a63bd450-8c1a-48df-83eb-69e3f0e64ee1/assets/eb4a2aec-5b6e-4291-a0c2-afb37b07d3c8","mime":"image/png"}]}