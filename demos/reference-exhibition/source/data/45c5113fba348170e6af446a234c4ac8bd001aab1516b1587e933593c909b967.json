depth":0.65,"width":0.65,"height":0.9}},"placementId":"f2dd8441-af53-4737-9d50-ca48a5a97a63"}]},"org.exhibitos.studio/presentation":{"credits":"회화: Metropolitan Museum of Art Open Access(CC0). 조각: Edmonia Lewis, Old Arrow Maker, modeled 1866, marble, Smithsonian American Art Museum, Gift of Mr. and Mrs. Norman Robbins, 1983.95.179; Smithsonian 3D(CC0). 오픈 액세스 자료를 활용한 ExhibitOS의 독립 전시이며, 소장 기관의 후원·제휴·보증을 뜻하지 않습니다.","version":1,"viewpoints":[{"id":"fc0f8a3c-185e-40da-996b-018dfdd28cc6","fov":50,"name":"조각을 앉아서 감상","roomId":"42587224-9481-4c4e-ab81-2a7d1b09d052","target":[0,1.17,0],"position":[0,1.15,1.92]}],"startCamera":{"fov":60,"roomId":"c4bad805-9924-48d3-9357-1abb83fc69eb","target":[-2.2,1.5,-4.94],"position":[-2.2,1.65,-2]}},"org.exhibitos.studio/light-details":{"lights":[{"aim":{"kind":"point","position":[0,0,0]},"fixture":"none","lightId":"75723731-a10a-4acb-9833-5a45e227b365"},{"aim":{"kind":"placement-center"},"range":12,"fixture":"spot-can","lightId":"ee0a74c6-5954-42b5-8baa-44d29893efdf","penumbra":0.35,"temperatureKelvin":4000}],"version":1}},"navigation":[],"placements":[{"id":"e4af3c75-7fbc-4f5e-9d06-cd65deec807e","roomId":"c4bad805-9924-48d3-9357-1abb83fc69eb","assetId":"fe7ef462-778e-4135-a12f-f28a34bcda64","transform":{"scale":[1,1,1],"position":[-2.2,1.5,-4.94],"rotation":[0,0,0,1]},"artworkRevisionId":"913f61bc-8b14-4a11-b496-e89ba9879d79"},{"id":"f1d6b143-a642-4bfc-aea8-7e174ef55b46","roomId":"c4bad805-9924-48d3-9357-1abb83fc69eb","assetId":"4a18897c-c5cc-4776-8585-6a161401b26d","transform":{"scale":[1,1,1],"position":[0,1.5,-4.94],"rotation":[0,0,0,1]},"artworkRevisionId":"7f662e34-31d7-436a-a1f9-5edae7dd52ce"},{"id":"4c2802c9-0e6b-4062-b31e-462c8adc7067","roomId":"c4bad805-9924-48d3-9357-1abb83fc69eb","assetId":"2cce9da2-fcf7-43dd-888c-021da39f8b20","transform":{"scale":[1,1,1],"position":[2.2,1.5,-4.94],"rotation":[0,0,0,1]},"artworkRevisionId":"698ffd0e-d058-4905-b503-7e11b8ec3539"},{"id":"f2dd8441-af53-4737-9d50-ca48a5a97a63","roomId":"42587224-9481-4c4e-ab81-2a7d1b09d052","assetId":"667c12bd-d362-4f59-8cf8-4f67c144adea","transform":{"scale":[1,1,1],"position":[0,1.1709545037505449,0],"rotation":[0,0,0,1]},"artworkRevisionId":"6c826592-82d1-4b0c-851d-a5ed426d7b34"}],"revisionId":"c463b9f8-15c0-4889-a959-267eed601fef","annotations":[],"coordinates":"right-handed-y-up","mediaAssets":[],"accessibility":{"routeIds":[],"reducedMotion":true,"alternativeView":"list","keyboardNavigation":true,"artworkDescriptions":[{"text":"빈센트 반 고흐 · Wheat Field with Cypresses · 1889 · 캔버스에 유채 · 73.2 × 93.4 cm · 메트로폴리탄 미술관, 1993.132\n\n밀밭과 하늘을 이루는 붓질의 방향을 따라가 보세요. 아래쪽의 짧고 비스듬한 선과 위쪽의 크게 굽이치는 선이 화면의 서로 다른 움직임을 만듭니다.\n\n가로 화면 아래에는 노란 밀밭이 펼쳐지고, 가운데에는 녹색 관목과 푸른 산이 보입니다. 오른쪽의 짙은 녹색 나무가 높게 솟아 있습니다. 위쪽 하늘에는 흰 구름과 푸른색·청록색의 굽은 붓자국이 이어집니다.","placementId":"e4af3c75-7fbc-4f5e-9d06-cd65deec807e"},{"text":"렘브란트 판 레인 · Aristotle with a Bust of Homer · 1653 · 캔버스에 유채 · 143.5 × 136.5 cm · 메트로폴리탄 미술관, 61.198\n\n밝게 드러난 손과 소매, 흉상을 차례로 살펴보세요. 한 화면에서 그려진 석상과 옷감, 금속 사슬이 서로 다른 표면으로 보이는 방식을 비교할 수 있습니다.\n\n어두운 배경 앞에 검은 모자와 밝고 넓은 소매의 옷을 입은 남자가 서 있습니다. 화면 왼쪽의 밝은 흉상 머리 위에 한 손을 얹고, 다른 손은 허리 가까이에 둡니다. 금빛 사슬이 가슴과 허리를 가로지릅니다.","placementId":"f1d6b143-a642-4bfc-aea8-7e174ef55b46"},{"text":"폴 세잔 · Still Life with Apples and Pears · 약 1891–1892 · 캔버스에 유채 · 44.8 × 58.7 cm · 메트로폴리탄 미술관, 61.101.3\n\n과일의 윤곽과 과일 사이의 빈 공간을 번갈아 보세요. 노란색·빨간색·녹색 면과 짙은 테두리가 둥근 과일을 드러내며, 뒤쪽의 접시와 벽은 깊이를 다르게 느끼게 합니다.\n\n나무 탁자 위에 노란색과 녹색의 배, 붉은색과 노란색의 사과가 놓여 있습니다. 뒤쪽에는 푸른 테두리의 흰 접시 두 개가 일부 보이고, 벽은 푸른 회색입니다. 탁자 앞면과 오른쪽 다리도 화면에 들어와 있습니다.","placementId":"4c2802c9-0e6b-4062-b31e-462c8adc7067"},{"text":"에드모니아 루이스 · Old Arrow Maker · 1866년 모델 제작 · 대리석 · 기관 보고 치수 54.5 × 34.5 × 34.0 cm(기관 표기 순서) · 스미스소니언 미국미술관, 1983.95.179 · Norman Robbins 부부 기증\n\n대리석 작품을 디지털로 기록한 3D 모델입니다. 회화의 표면과 조각의 입체가 화면에서 각각 어떻게 드러나는지 비교해 보세요. ‘1866년 모델 제작’이라는 기관의 연대 표기와 실제 전시 파일의 디지털 변환 이력은 구분합니다.\n\n정면 화면에서 밝은 아이보리색의 두 인물이 낮은 타원형 받침 위에 나란히 앉아 있습니다. 화면 왼쪽 인물은 더 낮게 앉아 있고, 오른쪽 인물의 머리와 어깨는 그보다 높게 보입니다. 두 인물의 팔과 손은 몸 앞에 모여 있고, 옷의 주름이 무릎과 다리 주위로 이어집니다. 인물과 받침의 표면에는 밝고 어두운 부분이 섞여 보입니다.\n\n크기 안내: 기관 보고 높이는 0.545 m, 제공 모델의 Y 범위는 0.5419090075010902 m입니다. 모델 좌표와 방향은 원래대로 유지하며 물리적 크기·축을 독립적으로 보정하거나 측정한 결과가 아닙니다.","placementId":"f2dd8441-af53-4737-9d50-ca48a5a97a63"}],"stationaryNavigation":true},"schemaVersion":"1.0.0-draft.1"},"assets":[{"assetId":"fe7ef462-778e-4135-a12f-f28a34bcda64","url":"/api/v1/publications/32c02fe6-e003-43f4-859b-a8c5b4a8f046/assets/fe7ef462-778e-4135-a12f-f28a34bcda64","mime":"image/png"},{"assetId":"d2e93784-d480-462e-834a-115cc5a540df","url":"/api/v1/publications/32c02fe6-e003-43f4-859b-a8c5b4a8f046/assets/d2e93784-d480-462e-834a-115cc5a540df","mime":"image/png"},{"assetId":"4a18897c-c5cc-4776-8585-6a161401b26d","url":"/api/v1/publications/32c02fe6-e003-43f4-859b-a8c5b4a8f046/assets/4a18897c-c5cc-4776-8585-6a161401b26d","mime":"image/png"},{"assetId":"fe8775b7-08d2-4722-91f7-0da7adf15ca6","url":"/api/v1/publications/32c02fe6-e003-43f4-859b-a8c5b4a8f046/assets/fe8775b7-08d2-4722-91f7-0da7adf15ca6","mime":"image/png"},{"assetId":"2cce9da2-fcf7-43dd-888c-021da39f8b20","url":"/api/v1/publications/32c02fe6-e003-43f4-859b-a8c5b4a8f046/assets/2cce9da2-fcf7-43dd-888c-021da39f8b20","mime":"image/png"},{"assetId":"0baf37ed-cf14-427f-b98f-cda28a1793d5","url":"/api/v1/publications/32c02fe6-e003-43f4-859b-a8c5b4a8f046/assets/0baf37ed-cf14-427f-b98f-cda28a1793d5","mime":"image/png"},{"assetId":"667c12bd-d362-4f59-8cf8-4f67c144adea","url":"/api/v1/publications/32c02fe6-e003-43f4-859b-a8c5b4a8f046/assets/667c12bd-d362-4f59-8cf8-4f67c144adea","mime":"model/gltf-binary"}]}