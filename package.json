{
  "name": "exhibitos-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev:web": "npm run dev --workspace @exhibitos/web",
    "dev:api": "npm run dev --workspace @exhibitos/api",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p tsconfig.tooling.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "npm run notices && npm run build --workspace @exhibitos/studio-contract && npm run build --workspace @exhibitos/storage && npm run build --workspace @exhibitos/api && npm run build --workspace @exhibitos/web",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:contracts",
    "measure:baseline": "node scripts/measure-baseline.mjs",
    "notices": "node scripts/write-notices.mjs",
    "test:contracts": "node --test scripts/contract-consumer.test.mjs",
    "conformance": "node scripts/contract-conformance.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "storage:migrate": "node scripts/migrate-storage.mjs",
    "storage:init": "node scripts/init-storage-env.mjs",
    "pretypecheck": "npm run build --workspace @exhibitos/studio-contract && npm run build --workspace @exhibitos/storage",
    "test:auth": "npm run build && node scripts/test-auth.mjs",
    "auth:bootstrap": "node scripts/bootstrap-admin.mjs",
    "test:import": "npm run build && node scripts/test-import.mjs",
    "import:work": "node scripts/import-worker.mjs",
    "test:cms": "npm run build && node scripts/test-cms.mjs",
    "test:drafts": "npm run build && node scripts/test-drafts.mjs",
    "test:geometry": "npm run build && node scripts/test-geometry.mjs",
    "test:publication": "npm run build && node scripts/test-publication.mjs",
    "test:navigation": "npm run build && node scripts/test-navigation.mjs",
    "test:viewer": "npm run build && node --test scripts/viewer-variants.test.mjs && node scripts/test-viewer.mjs",
    "test:experience": "npm run build && node scripts/test-experience.mjs",
    "test:accessibility": "npm run build && EXHIBITOS_ACCESSIBILITY_ONLY=1 node scripts/test-experience.mjs",
    "test:oex": "npm run build && node --test scripts/png-profile.test.mjs && node scripts/test-oex.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@exhibitos/spec": "file:vendor/exhibitos-spec-0.1.0-draft.2-164525a8cbcf.tgz"
  }
}
